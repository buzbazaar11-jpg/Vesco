# ============================================================
# Vesco Science — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# On Vercel: add these in Project → Settings → Environment Variables
# ============================================================

# --- Supabase (REQUIRED) ------------------------------------
# Find these in: supabase.com → your project → Settings → API
#
# Project URL  (e.g. https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Anon / public key  (starts with eyJ...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Nitro / Build (set automatically by vercel.json) -------
# Do NOT add this manually in Vercel — vercel.json handles it.
# NITRO_PRESET=vercel
